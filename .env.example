# Firebase Web App configuration. Firebase web config is public identification, not a secret.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Deployed Cloudflare Worker URL, for example:
# https://finlens-ai.YOUR-SUBDOMAIN.workers.dev
VITE_AI_WORKER_URL=

# true only when running Firebase Auth/Firestore emulators locally
VITE_USE_EMULATORS=false
